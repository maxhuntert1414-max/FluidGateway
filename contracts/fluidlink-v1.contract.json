{
  "contract": "fluidlink-v1",
  "wire": {
    "magic_ascii": "FLNK",
    "version": 1,
    "byte_order": "little-endian",
    "header_size": 56,
    "max_payload_bytes": 1048576,
    "payload_encoding": "utf-8-json-object"
  },
  "limits": {
    "max_json_depth": 64,
    "finite_json_numbers_only": true,
    "max_capabilities": 64,
    "max_capability_name_utf8_bytes": 128,
    "max_peer_name_utf8_bytes": 128,
    "max_peer_version_utf8_bytes": 64,
    "max_nonce_utf8_bytes": 128
  },
  "header": [
    {"name": "magic", "offset": 0, "size": 4, "type": "ascii"},
    {"name": "wire_version", "offset": 4, "size": 1, "type": "u8"},
    {"name": "kind", "offset": 5, "size": 1, "type": "u8"},
    {"name": "opcode", "offset": 6, "size": 1, "type": "u8"},
    {"name": "subject_opcode", "offset": 7, "size": 1, "type": "u8"},
    {"name": "decision_opcode", "offset": 8, "size": 1, "type": "u8"},
    {"name": "flags", "offset": 9, "size": 1, "type": "u8"},
    {"name": "reserved", "offset": 10, "size": 2, "type": "u16"},
    {"name": "sequence", "offset": 12, "size": 8, "type": "u64"},
    {"name": "message_id", "offset": 20, "size": 16, "type": "bytes"},
    {"name": "session_id", "offset": 36, "size": 16, "type": "bytes"},
    {"name": "payload_size", "offset": 52, "size": 4, "type": "u32"}
  ],
  "kinds": {
    "request": 1,
    "response": 2
  },
  "flags": {
    "ok": 1,
    "has_session": 2,
    "json_payload": 4
  },
  "opcodes": {
    "hello": 1,
    "welcome": 2,
    "runtime_event": 10,
    "runtime_decision": 11,
    "ping": 20,
    "pong": 21,
    "goodbye": 30,
    "error": 255
  },
  "event_opcodes": {
    "session": 100,
    "frame": 101,
    "resource": 102,
    "operation": 103,
    "state": 104
  },
  "decision_opcodes": {
    "execute": 0,
    "eliminate_self_copy": 1,
    "deduplicate_identical_transfer": 2,
    "collapse_aliased_resource_copy": 3,
    "remove_orphan_sync": 4,
    "remove_empty_sync": 5,
    "reuse_transient_buffer": 6,
    "unknown": 255
  },
  "capabilities": [
    "binary.framing.v1",
    "compact.decisions.v1",
    "heartbeat.v1",
    "memory.transit.v1",
    "runtime.decisions.v1",
    "runtime.events.v1",
    "session.lifecycle.v1"
  ],
  "handshake": {
    "hello_required_fields": [
      "contract_sha256",
      "client",
      "capabilities",
      "required_capabilities"
    ],
    "welcome_required_fields": [
      "contract_sha256",
      "server",
      "available_capabilities",
      "accepted_capabilities",
      "limits"
    ],
    "contract_rule": "exact-sha256-match"
  }
}
